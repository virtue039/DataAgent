      "type": "Concept",
      "name": "SAT Scores are greater or equal to 1500",
      "defined_by": "r4"
    },
    "f1": {
      "id": "f1",
      "type": "Formula",
      "grounding": [
        {
          "term": "Free Meal Count (K-12)",
          "table": "frpm",
          "column": "Free Meal Count (K-12)"
        },
        {
          "term": "Enrollment (K-12)",
          "table": "frpm",
          "column": "Enrollment (K-12)"
        }
      ],
      "name": "Eligible free rate for K-12",
      "expression": "`Free Meal Count (K-12)` / `Enrollment (K-12)`"
    },
    "f2": {
      "id": "f2",
      "type": "Formula",
      "grounding": [
        {
          "term": "Free Meal Count (Ages 5-17)",
          "table": "frpm",
          "column": "Free Meal Count (Ages 5-17)"
        },
        {
          "term": "Enrollment (Ages 5-17)",
          "table": "frpm",
          "column": "Enrollment (Ages 5-17)"
        }
      ],
      "name": "Eligible free rates for students aged 5-17",
      "expression": "`Free Meal Count (Ages 5-17)` / `Enrollment (Ages 5-17)`"
    },
    "f3": {
      "id": "f3",
      "type": "Formula",
      "grounding": [
        {
          "term": "Enrollment (K-12)",
          "table": "frpm",
          "column": "Enrollment (K-12)"
        },
        {
          "term": "Enrollment (Ages 5-17)",
          "table": "frpm",
          "column": "Enrollment (Ages 5-17)"
        }
      ],
      "name": "Total enrollment",
      "expression": "`Enrollment (K-12)` + `Enrollment (Ages 5-17)`"
    },
    "f4": {
      "id": "f4",
      "type": "Formula",
      "grounding": [
        {
          "term": "NumGE1500",
          "table": "satscores",
          "column": "NumGE1500"
        },
        {
          "term": "NumTstTakr",
          "table": "satscores",
          "column": "NumTstTakr"
        }
      ],
      "name": "Excellence rate",
      "expression": "NumGE1500 / NumTstTakr"
    },
    "f5": {
      "id": "f5",
      "type": "Formula",
      "grounding": [
        {
          "term": "Enrollment (K-12)",
          "table": "frpm",
          "column": "Enrollment (K-12)"
        },
        {
          "term": "Enrollment (Ages 5-17)",
          "table": "frpm",
          "column": "Enrollment (Ages 5-17)"
        }
      ],
      "name": "Diffrence in enrollement",
      "expression": "`Enrollment (K-12)` - `Enrollment (Ages 5-17)`"
    },
    "f6": {
      "id": "f6",
      "type": "Formula",
      "grounding": [
        {
          "term": "average math scores",
          "table": "satscores",
          "column": "AvgScrMath"
        },
        {
          "term": "schools",
          "table": "schools",
          "column": "CDSCode"
        }
      ],
      "name": "Average of average math",
      "expression": "sum(average math scores) / count(schools)"
    },
    "f7": {
      "id": "f7",
      "type": "Formula",
      "grounding": [
        {
          "term": "FRPM Count (K-12)",
          "table": "frpm",
          "column": "FRPM Count (K-12)"
        },
        {
          "term": "Enrollment (K-12)",
          "table": "frpm",
          "column": "Enrollment (K-12)"
        }
      ],
      "name": "Eligible free or reduced price meal rate for K-12",
      "expression": "`FRPM Count (K-12)` / `Enrollment (K-12)`"
    },
