    "f1": {
      "id": "f1",
      "type": "Formula",
      "grounding": [
        {
          "term": "average salary",
          "table": "district",
          "column": "A11"
        }
      ],
      "name": "Gap",
      "expression": "highest average salary - lowest average salary"
    },
    "f2": {
      "id": "f2",
      "type": "Formula",
      "grounding": [
        {
          "term": "clients",
          "table": "client",
          "column": "client_id"
        }
      ],
      "depends_on": [
        "r4"
      ],
      "name": "Percentage of the male clients",
      "expression": "DIVIDE(COUNT(male clients), COUNT(clients)) * 100"
    },
    "f3": {
      "id": "f3",
      "type": "Formula",
      "grounding": [
        {
          "term": "balance of date A",
          "table": "trans",
          "column": "balance"
        },
        {
          "term": "balance of date B",
          "table": "trans",
          "column": "balance"
        }
      ],
      "name": "increase rate of account balance",
      "expression": "((balance of date A - balance of date B) / balance of Date B) * 100"
    },
    "f4": {
      "id": "f4",
      "type": "Formula",
      "grounding": [
        {
          "term": "amount",
          "table": "loan",
          "column": "amount"
        }
      ],
      "name": "Percentage of accounts by condition",
      "expression": "(total(amount) & condition) / (total amount) * 100"
    },
    "f5": {
      "id": "f5",
      "type": "Formula",
      "grounding": [
        {
          "term": "amount",
          "table": "loan",
          "column": "amount"
        }
      ],
      "name": "Percentage of accounts by condition",
      "expression": "[(total(amount) & condition) / (total amount)] * 100"
    },
