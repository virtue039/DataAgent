    "r1": {
      "id": "r1",
      "type": "Rule",
      "grounding": [
        {
          "term": "birth_date",
          "table": "client",
          "column": "birth_date"
        }
      ],
      "name": "older than",
      "condition": "A.birth_date > B.birth_date"
    },
    "r2": {
      "id": "r2",
      "type": "Rule",
      "grounding": [
        {
          "term": "birth_date",
          "table": "client",
          "column": "birth_date"
        }
      ],
      "name": "person B is younger than person A",
      "condition": "A.birth_date < B.birth_date"
    },
