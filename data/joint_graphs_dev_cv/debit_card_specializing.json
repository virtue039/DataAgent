    "f1": {
      "id": "f1",
      "type": "Formula",
      "grounding": [
        {
          "term": "Currency",
          "table": "customers",
          "column": "Currency"
        }
      ],
      "name": "EUR to CZK customer ratio",
      "expression": "count(Currency = 'EUR') / count(Currency = 'CZK')"
    },
    "f2": {
      "id": "f2",
      "type": "Formula",
      "grounding": [
        {
          "term": "Date",
          "table": "yearmonth",
          "column": "Date"
        }
      ],
      "name": "Year from Date",
      "expression": "SUBSTR(Date, 1, 4)"
    },
    "f3": {
      "id": "f3",
      "type": "Formula",
      "grounding": [
        {
          "term": "Consumption",
          "table": "yearmonth",
          "column": "Consumption"
        }
      ],
      "name": "Average Monthly consumption",
      "expression": "AVG(Consumption) / 12"
    },
    "f4": {
      "id": "f4",
      "type": "Formula",
      "grounding": [
        {
          "term": "Consumption",
          "table": "yearmonth",
          "column": "Consumption"
        },
        {
          "term": "Date",
          "table": "yearmonth",
          "column": "Date"
        },
        {
          "term": "Currency",
          "table": "customers",
          "column": "Currency"
        }
      ],
      "depends_on": [
        "r1",
        "r4",
        "r5"
      ],
      "name": "Difference in Consumption",
      "expression": "CZK customers consumption in 2012 - EUR customers consumption in 2012"
    },
    "f5": {
      "id": "f5",
      "type": "Formula",
      "grounding": [
        {
          "term": "Date",
          "table": "yearmonth",
          "column": "Date"
        }
      ],
      "name": "Month from Date",
      "expression": "SUBSTR(Date, 5, 2)"
    },
    "f6": {
      "id": "f6",
      "type": "Formula",
      "grounding": [
        {
          "term": "total consumption per year",
          "table": "yearmonth",
          "column": "Consumption"
        },
        {
          "term": "the number of customer with lowest consumption in each segment",
          "table": "customers",
          "column": "CustomerID"
        },
        {
          "term": "Segment",
          "table": "customers",
          "column": "Segment"
        }
      ],
      "name": "annual average consumption of customer with the lowest consumption in each segment",
      "expression": "total consumption per year / the number of customer with lowest consumption in each segment"
    },
    "f7": {
      "id": "f7",
      "type": "Formula",
      "grounding": [
        {
          "term": "SME's annual average",
          "table": "yearmonth",
          "column": "Consumption"
        },
        {
          "term": "LAM's annual average",
          "table": "yearmonth",
          "column": "Consumption"
        },
        {
          "term": "Segment",
          "table": "customers",
          "column": "Segment"
        }
      ],
      "depends_on": [
        "f6"
      ],
      "name": "Difference in annual average (SME - LAM)",
      "expression": "SME's annual average - LAM's annual average"
    },
    "f8": {
      "id": "f8",
      "type": "Formula",
      "grounding": [
        {
          "term": "LAM's annual average",
          "table": "yearmonth",
          "column": "Consumption"
        },
        {
          "term": "KAM's annual average",
          "table": "yearmonth",
          "column": "Consumption"
        },
        {
          "term": "Segment",
          "table": "customers",
          "column": "Segment"
        }
      ],
      "depends_on": [
        "f6"
      ],
      "name": "Difference in annual average (LAM - KAM)",
      "expression": "LAM's annual average - KAM's annual average"
    },
    "f9": {
      "id": "f9",
      "type": "Formula",
      "grounding": [
        {
          "term": "consumption for 2013",
          "table": "yearmonth",
          "column": "Consumption"
        },
        {
          "term": "consumption for 2012",
          "table": "yearmonth",
          "column": "Consumption"
        }
      ],
      "name": "Increase or Decrease",
      "expression": "consumption for 2013 - consumption for 2012"
    },
    "f10": {
      "id": "f10",
      "type": "Formula",
      "grounding": [
        {
          "term": "Increase or Decrease",
          "table": "yearmonth",
          "column": "Consumption"
        },
        {
          "term": "consumption for 2013",
          "table": "yearmonth",
          "column": "Consumption"
        }
      ],
      "depends_on": [
        "f9"
      ],
      "name": "Percentage of Increase",
      "expression": "(Increase or Decrease / consumption for 2013) * 100%"
    },
    "f11": {
      "id": "f11",
      "type": "Formula",
      "grounding": [
        {
          "term": "Total no. of discount gas stations in Czech Republic",
          "table": "gasstations",
          "column": "GasStationID"
        },
        {
          "term": "Total no. of discount gas stations in Slovakia",
          "table": "gasstations",
          "column": "GasStationID"
        }
      ],
      "depends_on": [
        "v1",
        "v2"
      ],
      "name": "Computation of more discount gas stations",
      "expression": "Total no. of discount gas stations in Czech Republic - Total no. of discount gas stations in Slovakia"
    },
    "f12": {
      "id": "f12",
      "type": "Formula",
      "grounding": [
        {
          "term": "Total of SMEs pay using Currency CZK",
          "table": "transactions_1k",
          "column": "Amount"
        },
        {
          "term": "Total of SMEs pay using Currency EUR",
          "table": "transactions_1k",
          "column": "Amount"
        }
      ],
      "name": "Amount of more SMEs",
      "expression": "Total of SMEs pay using Currency CZK - Total of SMEs pay using Currency EUR"
    },
    "f13": {
      "id": "f13",
      "type": "Formula",
      "grounding": [
        {
          "term": "CustomerID",
          "table": "customers",
          "column": "CustomerID"
        },
        {
          "term": "Segment",
          "table": "customers",
          "column": "Segment"
        },
        {
          "term": "Consumption",
          "table": "yearmonth",
          "column": "Consumption"
        }
      ],
      "depends_on": [
        "r9",
        "r10"
      ],
      "name": "Percentage of LAM customer consumed more than 46.73",
      "expression": "(Total no. of LAM customers who consumed more than 46.73 / Total no. of LAM customers) * 100"
    },
    "f14": {
      "id": "f14",
      "type": "Formula",
      "grounding": [
        {
          "term": "KAM",
          "table": "customers",
          "column": "Segment"
        },
        {
          "term": "Euro",
          "table": "customers",
          "column": "Currency"
        }
      ],
      "name": "Percentage of KAM uses Euro",
      "expression": "(Total of KAM uses Euro / Total of KAM) * 100"
    },
    "f15": {
      "id": "f15",
      "type": "Formula",
      "grounding": [
        {
          "term": "Total of premium gas station in Slovakia",
          "table": "gasstations",
          "column": "GasStationID"
        },
        {
          "term": "Total of gas station in Slovakia",
          "table": "gasstations",
          "column": "GasStationID"
        }
      ],
      "depends_on": [
        "r11",
        "r12"
      ],
      "name": "Percentage of premium gas station",
      "expression": "(Total of premium gas station in Slovakia / Total of gas station in Slovakia) * 100"
    },
    "f16": {
      "id": "f16",
      "type": "Formula",
      "grounding": [
        {
          "term": "consumption",
          "table": "yearmonth",
          "column": "Consumption"
        }
      ],
      "name": "Monthly consumption",
      "expression": "SUM(consumption) / 12"
    },
